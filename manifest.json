{
  "manifest_version": 3,
  "name": "Blackout for YouTube",
  "version": "0.1.0",
  "description": "Hide or blackout videos, Shorts, and community posts from channels you do not want to see.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {"default_title": "Blackout for YouTube", "default_popup": "popup.html"},
  "options_page": "options.html",
  "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]
}
